{
  "manifest_version": 3,
  "name": "grip-post",
  "version": "0.0.1",
  "description": "Unicode formatter + anti-fluff gate for LinkedIn posts. Refuses to write fluff.",
  "permissions": ["contextMenus", "storage", "sidePanel"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/feed/*",
        "https://www.linkedin.com/in/*"
      ],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/icons/16.png",
    "32": "src/icons/32.png",
    "48": "src/icons/48.png",
    "128": "src/icons/128.png"
  },
  "action": {
    "default_title": "grip-post",
    "default_icon": {
      "16": "src/icons/16.png",
      "32": "src/icons/32.png",
      "48": "src/icons/48.png",
      "128": "src/icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  }
}
