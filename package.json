{
  "name": "grip-post",
  "version": "0.1.1",
  "description": "Unicode formatter + anti-fluff gate for LinkedIn posts. Refuses to write fluff.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "verify-build": "node bin/verify-build.mjs",
    "package": "npm run build && npm run verify-build && node bin/package.mjs",
    "build:safari": "TARGET=safari vite build",
    "package:safari": "npm run build:safari && node bin/package-safari.mjs",
    "dev:web": "TARGET=web vite",
    "build:web": "TARGET=web vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.270",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  }
}
